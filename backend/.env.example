# 复制为 .env 后填写，.env 不提交到仓库

APP_ENV=dev

# MySQL 5.7 / 8，库使用 utf8mb4（表的排序规则由迁移脚本指定为 utf8mb4_unicode_520_ci）
DATABASE_URL=mysql+aiomysql://underleaf:密码@127.0.0.1:3306/underleaf
DATABASE_ECHO=false

# Redis：验证码、发送冷却
REDIS_URL=redis://127.0.0.1:6379/0

# PDF 导出：无头 Chromium 访问前端渲染页的地址（本地为 Vite，服务器为本机 Nginx）
EXPORT_RENDER_URL=http://localhost:5173
# 本地开发填 chrome，直接使用已安装的 Google Chrome；服务器留空，使用 playwright install 安装的 Chromium
EXPORT_BROWSER_CHANNEL=chrome
# EXPORT_CONCURRENCY=2
# EXPORT_TIMEOUT_SECONDS=30

# 上传图片的存放目录（默认为仓库根目录下的 uploads/）；服务器上放在数据目录，见 docs/images.md
# UPLOAD_DIR=/home/ubuntu/data/underleaf/uploads

# Git 同步：每个用户的裸仓库存放目录（默认为仓库根目录下的 git-repos/）；服务器上放在数据目录
# GIT_REPO_DIR=/home/ubuntu/data/underleaf/git
# 单次 push 的大小上限（字节），Nginx 的 client_max_body_size 要大于它
# GIT_MAX_PUSH_BYTES=52428800

# ---------- 登录 ----------
# JWT 签名密钥（必填），生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 修改后所有用户需要重新登录
JWT_SECRET=
# 网站启用 HTTPS 后改为 true（Cookie 只在 HTTPS 下发送）
COOKIE_SECURE=false

# ---------- 邮件（发送验证码） ----------
# 不填 SMTP_HOST 时：开发环境把验证码打印到后端日志；正式环境（APP_ENV=prod）拒绝发送
# 以 QQ 邮箱为例：SMTP_HOST=smtp.qq.com，SMTP_PORT=465，SMTP_PASSWORD 为邮箱设置中生成的「授权码」
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Underleaf <你的邮箱>
